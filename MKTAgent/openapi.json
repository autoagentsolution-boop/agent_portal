{
  "openapi": "3.1.0",
  "info": {
    "title": "MKTAgent API",
    "version": "0.1.0",
    "description": "Multi-tenant marketing automation API. All endpoints are tenant-scoped via the Bearer JWT (Google login). Responses use the { data, meta? } | { error, details? } envelope."
  },
  "servers": [
    {
      "url": "http://localhost:7100",
      "description": "local dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PostStatus": {
        "type": "string",
        "enum": [
          "brief",
          "review",
          "rework",
          "ready",
          "posting",
          "posted",
          "partial",
          "error"
        ]
      },
      "AssetType": {
        "type": "string",
        "enum": [
          "image",
          "carousel",
          "video"
        ]
      },
      "SocialPlatform": {
        "type": "string",
        "enum": [
          "facebook",
          "instagram",
          "threads",
          "linkedin",
          "x"
        ]
      },
      "CopyBag": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "threads": {
            "type": "string"
          },
          "x": {
            "type": "string"
          }
        },
        "required": [
          "body",
          "threads",
          "x"
        ]
      },
      "CampaignDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "type": "string"
          },
          "angle": {
            "type": [
              "string",
              "null"
            ]
          },
          "brandContext": {
            "type": [
              "string",
              "null"
            ]
          },
          "leadsForm": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultLength": {
            "type": [
              "string",
              "null"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "threads",
                "linkedin",
                "x"
              ]
            }
          },
          "brandVoice": {
            "type": [
              "string",
              "null"
            ]
          },
          "postingWindow": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "product",
          "angle",
          "brandContext",
          "leadsForm",
          "active",
          "language",
          "defaultLength",
          "platforms",
          "brandVoice",
          "postingWindow",
          "timezone",
          "createdAt",
          "updatedAt"
        ]
      },
      "PostDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "brief",
              "review",
              "rework",
              "ready",
              "posting",
              "posted",
              "partial",
              "error"
            ]
          },
          "assetType": {
            "type": "string",
            "enum": [
              "image",
              "carousel",
              "video"
            ]
          },
          "copy": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "threads": {
                "type": "string"
              },
              "x": {
                "type": "string"
              }
            },
            "required": [
              "body",
              "threads",
              "x"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "lengthSpec": {
            "type": [
              "string",
              "null"
            ]
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ]
          },
          "driveFolderId": {
            "type": [
              "string",
              "null"
            ]
          },
          "heroFile": {
            "type": [
              "string",
              "null"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "threads",
                "linkedin",
                "x"
              ]
            }
          },
          "scheduledAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "postUrls": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "postedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "campaignId",
          "status",
          "assetType",
          "copy",
          "language",
          "lengthSpec",
          "feedback",
          "driveFolderId",
          "heroFile",
          "platforms",
          "scheduledAt",
          "postUrls",
          "error",
          "postedAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "PostDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "brief",
              "review",
              "rework",
              "ready",
              "posting",
              "posted",
              "partial",
              "error"
            ]
          },
          "assetType": {
            "type": "string",
            "enum": [
              "image",
              "carousel",
              "video"
            ]
          },
          "copy": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "threads": {
                "type": "string"
              },
              "x": {
                "type": "string"
              }
            },
            "required": [
              "body",
              "threads",
              "x"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "lengthSpec": {
            "type": [
              "string",
              "null"
            ]
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ]
          },
          "driveFolderId": {
            "type": [
              "string",
              "null"
            ]
          },
          "heroFile": {
            "type": [
              "string",
              "null"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "threads",
                "linkedin",
                "x"
              ]
            }
          },
          "scheduledAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "postUrls": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "postedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "campaign": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "product": {
                "type": "string"
              },
              "angle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "brandContext": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "leadsForm": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "active": {
                "type": "boolean"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "defaultLength": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "facebook",
                    "instagram",
                    "threads",
                    "linkedin",
                    "x"
                  ]
                }
              },
              "brandVoice": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "postingWindow": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
