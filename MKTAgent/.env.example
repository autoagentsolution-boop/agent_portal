# MKTAgent environment — copy to .env and fill. NEVER commit the real .env.

# --- Core ---
NODE_ENV=development
PORT=7100
# Postgres for MKTAgent (separate DB from video-farm). Docker compose default:
DATABASE_URL=postgresql://mktagent:mktagent@localhost:5433/mktagent
# Comma-separated API keys for REST + webhook auth.
MKT_API_KEYS=

# --- Token encryption (AES-256-GCM) ---
# 64 hex chars (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# --- Google (Drive asset store + Sheets import + Gmail notify) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# App-login OAuth client (identity scope only — distinct from Drive). Redirect URI
# must match the Google console entry: <host>/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7100/auth/google/callback

# --- App auth / browser session (T1 + T8) ---
# HS256 secret for JWTs (CLI/service) + login `state` nonces. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=60d
# Browser BFF: when set, the Google callback issues an HttpOnly opaque-session
# cookie and redirects here (NO token in the URL); also the sole CORS origin for
# credentialed XHR. Leave empty for the CLI/JSON-token flow (no browser UI).
UI_BASE_URL=http://localhost:5173
SESSION_TTL=30d

# --- Gemini (copy-gen) ---
GEMINI_API_KEY=

# --- Lead capture ---
MKT_LEAD_WEBHOOK_SECRET=
MKT_CALCOM_WEBHOOK_SECRET=
MKT_SALES_EMAIL=

# --- Meta (Facebook Page + Instagram + Threads) ---
MKT_FB_PAGE_ID=
MKT_FB_PAGE_ACCESS_TOKEN=
MKT_IG_USER_ID=
MKT_IG_ACCESS_TOKEN=
MKT_THREADS_USER_ID=
MKT_THREADS_ACCESS_TOKEN=

# --- LinkedIn ---
MKT_LINKEDIN_PERSON_ID=
MKT_LINKEDIN_ACCESS_TOKEN=

# --- X / Twitter ---
MKT_X_ACCESS_TOKEN=

# --- Graph API versions (pinned) ---
GRAPH_VERSION=v25.0
THREADS_VERSION=v1.0
