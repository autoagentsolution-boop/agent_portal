// MKTAgent Postgres schema — marketing control plane.
// Source of truth replacing the Google Sheets control plane.
// Campaign 1─N Post; assets referenced by Drive folder + filename (AssetStore
// abstracts this so S3/local can swap in later). Tokens encrypted at rest.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Post lifecycle (ported from the n8n Sheet `status` column):
//   brief    → user/seed created, copy not yet generated
//   review   → copy generated, awaiting human approval
//   rework   → rejected, feedback attached, copy-gen will regenerate
//   ready    → approved + scheduled; scheduler will pick it up
//   posting  → claimed by scheduler (advisory-lock guarded)
//   posted   → all targeted platforms succeeded
//   partial  → some platforms succeeded
//   error    → none succeeded / validation failed
enum PostStatus {
  brief
  review
  rework
  ready
  posting
  posted
  partial
  error
}

// Asset shape drives which publish path runs.
enum AssetType {
  image
  carousel
  video
}

// Social platforms (lowercase to match the n8n `platforms` CSV values).
enum SocialPlatform {
  facebook
  instagram
  threads
  linkedin
  x
}

// Lead source attribution.
enum LeadSource {
  webhook
  form
  calcom
}

enum TokenStatus {
  active
  needs_attention
  revoked
}

// Account type gates branding behaviour in copy-gen (T3):
//   business → maintains brandName/brandVoice/brandContext (company persona)
//   personal → brand fields null → copy-gen runs persona-free (human sharing)
enum AccountType {
  business
  personal
}

// Content language is FREE-FORM (T3): the user picks a language on the UI and
// copy-gen generates the post in THAT language. Stored as a code/label string
// (e.g. "vi", "en", "fr", "Tiếng Việt") — not an enum — so any language scales
// without a schema change. One language per post (resolution: post → campaign →
// user default). The old vi|en|both enum is retired by the T3 migration.

enum UserRole {
  owner
  admin
}

// A tenant. Identity = email (from Google login). One User owns many Campaigns,
// Leads and OAuthTokens; every tenant-scoped query filters by this id (T2).
// Branding + language are config-as-data defaults inherited by campaigns (T3).
model User {
  id          String      @id @default(uuid()) @db.Uuid
  email       String      @unique
  displayName String?     @map("display_name")
  avatarUrl   String?     @map("avatar_url")
  // Google OAuth subject — stable per-account identity (email can change, sub
  // does not). Nullable so a future email/password user can exist without it.
  googleSub   String?     @unique @map("google_sub")
  // Nullable: Google-login is the only v1 path. argon2id hash lands when/if
  // email+password is added — passwordHash stays null until then.
  passwordHash String?    @map("password_hash")
  accountType AccountType @default(business) @map("account_type")
  // Config-as-data defaults (T3 three-layer resolution): user → campaign → post.
  // Free-form language code/label (default "vi"); campaign/post can override.
  defaultLanguage String @default("vi") @map("default_language")
  brandName    String?    @map("brand_name") // null for personal accounts
  brandVoice   String?    @map("brand_voice")
  brandContext String?    @map("brand_context")
  role        UserRole    @default(owner)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaigns Campaign[]
  posts     Post[]
  leads     Lead[]
  tokens    OAuthToken[]

  @@map("mkt_user")
}

// A marketing campaign: one product/offer + angle + brand context. Spawns posts.
model Campaign {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  product      String
  angle        String?
  brandContext String?  @map("brand_context")
  leadsForm    String?  @map("leads_form") // optional CTA form URL injected into copy
  active       Boolean  @default(true)
  // Config-as-data defaults (T3 §2). All nullable → inherit from User; a Post can
  // override per row. brandVoice null on a personal account → persona-free copy.
  language     String?           @map("language") // free-form; null → user.defaultLanguage
  defaultLength String?          @map("default_length") // short|medium|long|<wordcount>
  platforms    SocialPlatform[]  // default publish targets for new posts
  brandVoice   String?           @map("brand_voice") // null → inherit user.brandVoice
  postingWindow String?          @map("posting_window") // e.g. "09:00-11:00" (auto-schedule, T4/T5)
  timezone     String?           @map("timezone") // IANA tz for postingWindow
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([active], name: "ix_campaign_active")
  @@index([ownerId], name: "ix_campaign_owner")
  @@map("mkt_campaign")
}

// One scheduled publication. Copy variants + asset ref + platform targets + state.
model Post {
  id          String           @id @default(uuid()) @db.Uuid
  campaignId  String           @map("campaign_id") @db.Uuid
  // Denormalized tenant key (copied from campaign on create). Lets every tenant
  // post query filter on a flat indexed column instead of a campaign join, and
  // gives T4 the owner directly (post.ownerId → token lookup). Kept consistent
  // at write time; campaign reassignment (not a v1 feature) must re-sync.
  ownerId     String           @map("owner_id") @db.Uuid
  status      PostStatus       @default(brief)
  assetType   AssetType        @default(image) @map("asset_type")
  // Generated copy (by copy-gen, approved by human) as a language-agnostic bag:
  //   { "body": "<long, for FB/IG/LinkedIn>", "threads": "<≤480>", "x": "<≤280>" }
  // All variants are in the post's resolved `language` (T3 — one language per post).
  // JSON (not fixed columns) so any language scales without a schema change.
  copy        Json?            @map("copy")
  // Free-form language override (null → inherit campaign.language → user.defaultLanguage).
  language    String?          @map("language")
  lengthSpec  String?          @map("length_spec") // short|medium|long|<wordcount>
  feedback    String? // rework feedback fed back into copy-gen
  // Asset reference (Drive-backed for now; AssetStore abstracts the source).
  driveFolderId String?        @map("drive_folder_id")
  heroFile      String?        @map("hero_file") // 1 filename (image/video) or CSV (carousel)
  // Targeting + scheduling.
  platforms   SocialPlatform[]
  scheduledAt DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  // Outcome.
  postUrls    Json?            @map("post_urls") // { facebook: url, ... }
  error       String?
  postedAt    DateTime?        @map("posted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt], name: "ix_post_status_sched")
  @@index([campaignId], name: "ix_post_campaign")
  @@index([ownerId], name: "ix_post_owner")
  @@map("mkt_post")
}

// Inbound lead from any channel. Dedupe by email (30d) or calcom booking uid.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  // Leads aren't always campaign-bound, so tenancy is a direct column (plan §1).
  ownerId        String     @map("owner_id") @db.Uuid
  name           String?
  email          String
  phone          String?
  message        String?
  sourceProduct  String?    @map("source_product")
  source         LeadSource
  calBookingUid  String?    @map("cal_booking_uid")
  rawPayload     Json?      @map("raw_payload")
  receivedAt     DateTime   @default(now()) @map("received_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([email, receivedAt], name: "ix_lead_email_received")
  @@index([calBookingUid], name: "ix_lead_calcom_uid")
  @@index([ownerId], name: "ix_lead_owner")
  @@map("mkt_lead")
}

// OAuth token store — replaces the n8n credential vault. token + refreshToken
// are AES-256-GCM ciphertext (see lib/crypto.ts); never store plaintext.
// T4: per-user. PK is composite (ownerId, platform) — each tenant connects their
// own accounts. Pre-T4 DAIS rows are migrated onto the system owner.
model OAuthToken {
  ownerId      String         @map("owner_id") @db.Uuid
  platform     SocialPlatform
  token        String // encrypted
  refreshToken String?        @map("refresh_token") // encrypted
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)
  status       TokenStatus    @default(active)
  lastCheckedAt DateTime?     @map("last_checked_at") @db.Timestamptz(6)
  meta         Json? // platform-specific (page id, user id, etc.)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, platform])
  @@index([ownerId], name: "ix_token_owner")
  @@map("mkt_oauth_token")
}

// Chronological audit log; detail is free-form JSON. Ported from n8n mkt_run_log.
model MktRunLog {
  id        BigInt   @id @default(autoincrement())
  // Optional tenant attribution for per-user audit (plan §1). Nullable + no FK:
  // system/cron events have no owner, and audit rows must survive user deletion.
  ownerId   String?  @map("owner_id") @db.Uuid
  level     String
  step      String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], name: "ix_mkt_log_created")
  @@index([ownerId], name: "ix_mkt_log_owner")
  @@map("mkt_run_log")
}
