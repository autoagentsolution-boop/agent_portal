// MKTAgent Postgres schema — marketing control plane.
// Source of truth replacing the Google Sheets control plane.
// Campaign 1─N Post; assets referenced by Drive folder + filename (AssetStore
// abstracts this so S3/local can swap in later). Tokens encrypted at rest.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Post lifecycle (ported from the n8n Sheet `status` column):
//   brief    → user/seed created, copy not yet generated
//   review   → copy generated, awaiting human approval
//   rework   → rejected, feedback attached, copy-gen will regenerate
//   ready    → approved + scheduled; scheduler will pick it up
//   posting  → claimed by scheduler (advisory-lock guarded)
//   posted   → all targeted platforms succeeded
//   partial  → some platforms succeeded
//   error    → none succeeded / validation failed
enum PostStatus {
  brief
  review
  rework
  ready
  posting
  posted
  partial
  error
}

// Asset shape drives which publish path runs.
enum AssetType {
  image
  carousel
  video
}

// Social platforms (lowercase to match the n8n `platforms` CSV values).
enum SocialPlatform {
  facebook
  instagram
  threads
  linkedin
  x
}

// Lead source attribution.
enum LeadSource {
  webhook
  form
  calcom
  comment
}

enum TokenStatus {
  active
  needs_attention
  revoked
}

// Account type gates branding behaviour in copy-gen (T3):
//   business → maintains brandName/brandVoice/brandContext (company persona)
//   personal → brand fields null → copy-gen runs persona-free (human sharing)
enum AccountType {
  business
  personal
}

// Content language is FREE-FORM (T3): the user picks a language on the UI and
// copy-gen generates the post in THAT language. Stored as a code/label string
// (e.g. "vi", "en", "fr", "Tiếng Việt") — not an enum — so any language scales
// without a schema change. One language per post (resolution: post → campaign →
// user default). The old vi|en|both enum is retired by the T3 migration.

enum UserRole {
  owner
  admin
}

// A tenant. Identity = email (from Google login). One User owns many Campaigns,
// Leads and OAuthTokens; every tenant-scoped query filters by this id (T2).
// Branding + language are config-as-data defaults inherited by campaigns (T3).
model User {
  id          String      @id @default(uuid()) @db.Uuid
  email       String      @unique
  displayName String?     @map("display_name")
  avatarUrl   String?     @map("avatar_url")
  // Google OAuth subject — stable per-account identity (email can change, sub
  // does not). Nullable so a future email/password user can exist without it.
  googleSub   String?     @unique @map("google_sub")
  // Nullable: Google-login is the only v1 path. argon2id hash lands when/if
  // email+password is added — passwordHash stays null until then.
  passwordHash String?    @map("password_hash")
  accountType AccountType @default(business) @map("account_type")
  // Config-as-data defaults (T3 three-layer resolution): user → campaign → post.
  // Free-form language code/label (default "vi"); campaign/post can override.
  defaultLanguage String @default("vi") @map("default_language")
  brandName    String?    @map("brand_name") // null for personal accounts
  brandVoice   String?    @map("brand_voice")
  brandContext String?    @map("brand_context")
  role        UserRole    @default(owner)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaigns Campaign[]
  posts     Post[]
  leads     Lead[]
  tokens    OAuthToken[]
  sessions  Session[]
  agentChatSessions AgentChatSession[]
  agentCredentials   AgentCredential[]
  workflowRuns       WorkflowRun[]
  productKnowledge   ProductKnowledge[]
  leadIntakeTokens   LeadIntakeToken[]

  @@map("mkt_user")
}

// Per-owner lead intake token (Atria Lead Collector §01.1). An external funnel presents
// this token (URL/header) at /leads/* → it BOTH authenticates the call and identifies the
// owner, so a captured lead lands on the RIGHT tenant instead of the shared system owner.
// Only the SHA-256 hash is stored (the plaintext is shown once at creation); rotatable +
// revocable. The legacy global webhook secret still maps to the system owner (back-compat).
model LeadIntakeToken {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  label      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId], name: "ix_lead_intake_owner")
  @@map("mkt_lead_intake_token")
}

// Opaque server-side session for the browser BFF (T8). The browser holds only a
// random handle in an HttpOnly cookie; the JWT/credential NEVER reaches the client.
// We store the SHA-256 of the handle (not the handle itself) so a DB read cannot
// reconstruct a live cookie. Server-revocable (delete row) — strictly stronger
// than a stateless JWT-in-cookie, which can't be invalidated before expiry.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  // SHA-256 hex of the opaque cookie handle. Unique → O(1) lookup on each request.
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId], name: "ix_session_owner")
  @@index([expiresAt], name: "ix_session_expires")
  @@map("mkt_session")
}

// A marketing campaign: one product/offer + angle + brand context. Spawns posts.
model Campaign {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  // Optional parent Flow (the orchestration run that spawned this campaign). Nullable:
  // campaigns created directly (not via a flow) have none, and deleting a flow nulls
  // this (SetNull) rather than cascading — generated content (incl. paid images) must
  // outlive its flow. Drives the sidebar Flow → Campaign → Post tree.
  flowId       String?  @map("flow_id") @db.Uuid
  product      String
  angle        String?
  brandContext String?  @map("brand_context")
  // Optional link to a reusable Product Knowledge library entry (item 6). When set, it is the
  // primary source of product facts for grounding (resolution: post.pk → campaign.pk →
  // campaign.brandContext → goal slot). SetNull on entry delete → content survives.
  productKnowledgeId String? @map("product_knowledge_id") @db.Uuid
  leadsForm    String?  @map("leads_form") // optional CTA form URL injected into copy
  active       Boolean  @default(true)
  // Config-as-data defaults (T3 §2). All nullable → inherit from User; a Post can
  // override per row. brandVoice null on a personal account → persona-free copy.
  language     String?           @map("language") // free-form; null → user.defaultLanguage
  defaultLength String?          @map("default_length") // short|medium|long|<wordcount>
  platforms    SocialPlatform[]  // default publish targets for new posts
  brandVoice   String?           @map("brand_voice") // null → inherit user.brandVoice
  postingWindow String?          @map("posting_window") // e.g. "09:00-11:00" (auto-schedule, T4/T5)
  timezone     String?           @map("timezone") // IANA tz for postingWindow
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  flow  WorkflowRun? @relation(fields: [flowId], references: [id], onDelete: SetNull)
  productKnowledge ProductKnowledge? @relation(fields: [productKnowledgeId], references: [id], onDelete: SetNull)
  posts Post[]

  @@index([active], name: "ix_campaign_active")
  @@index([ownerId], name: "ix_campaign_owner")
  @@index([flowId], name: "ix_campaign_flow")
  @@index([productKnowledgeId], name: "ix_campaign_pk")
  @@map("mkt_campaign")
}

// One scheduled publication. Copy variants + asset ref + platform targets + state.
model Post {
  id          String           @id @default(uuid()) @db.Uuid
  campaignId  String           @map("campaign_id") @db.Uuid
  // Denormalized tenant key (copied from campaign on create). Lets every tenant
  // post query filter on a flat indexed column instead of a campaign join, and
  // gives T4 the owner directly (post.ownerId → token lookup). Kept consistent
  // at write time; campaign reassignment (not a v1 feature) must re-sync.
  ownerId     String           @map("owner_id") @db.Uuid
  // Optional link to the orchestration run that produced this post (concept_writer
  // stamps it). Lets the post show its own workflow DAG + drive per-node re-runs.
  // SetNull on run delete: the post's content survives if the flow is deleted.
  runId       String?          @map("run_id") @db.Uuid
  status      PostStatus       @default(brief)
  assetType   AssetType        @default(image) @map("asset_type")
  // Generated copy (by copy-gen, approved by human) as a language-agnostic bag:
  //   { "body": "<long, for FB/IG/LinkedIn>", "threads": "<≤480>", "x": "<≤280>" }
  // All variants are in the post's resolved `language` (T3 — one language per post).
  // JSON (not fixed columns) so any language scales without a schema change.
  copy        Json?            @map("copy")
  // True once the USER has modified the copy (manual /edit-copy, /select-variant, or AI /refine).
  // Protects that work: concept_writer must NOT regenerate over user-modified copy on a flow re-run
  // (the edit-loss bug). A fresh generation (rework / regenerate) clears it back to false.
  copyEdited  Boolean          @default(false) @map("copy_edited")
  // Free-form language override (null → inherit campaign.language → user.defaultLanguage).
  language    String?          @map("language")
  lengthSpec  String?          @map("length_spec") // short|medium|long|<wordcount>
  // Per-post overrides for its own strategy/voice (null → inherit campaign → user).
  // Lets one post in a campaign carry a distinct angle or brand voice.
  angle       String?          @map("angle")
  brandVoice  String?          @map("brand_voice")
  feedback    String? // rework feedback fed back into copy-gen
  // Asset reference (Drive-backed for now; AssetStore abstracts the source).
  driveFolderId String?        @map("drive_folder_id")
  heroFile      String?        @map("hero_file") // 1 filename (image/video) or CSV (carousel)
  // Per-platform asset type (item 5): { "facebook": "carousel", "instagram": "image" }.
  // Null / a platform missing from the map → that platform uses the default `assetType`.
  // Lets one post publish a different deliverable per platform (carousel on FB, single
  // image on LinkedIn/X). Values are AssetType strings; validated against platform support.
  platformAssets Json?        @map("platform_assets")
  // Per-asset-type media refs (item 5): { "carousel": "id1,id2", "video": "idV", "image": "idI" }.
  // Null / a missing type → fall back to `heroFile` (with carousel→first-frame degrade for
  // 'image'). The executor fills one key per DISTINCT asset type it generates; the publisher
  // picks the right media per platform from this map.
  assetMedia    Json?        @map("asset_media")
  // Optional per-post override of the Product Knowledge library entry (item 6). Null →
  // inherit the campaign's link → brandContext → goal slot. SetNull on entry delete.
  productKnowledgeId String?  @map("product_knowledge_id") @db.Uuid
  // Optional user-uploaded reference image (local:<path>) captured at the concept selection
  // gate. When set, infographic/storyboard generate FROM it (Gemini edit mode) instead of
  // pure text-to-image. (For a post with no media step the upload is written straight to
  // heroFile instead — see the reference-image route's asHero path.) Non-blocking.
  referenceImage String?     @map("reference_image")
  // Targeting + scheduling.
  platforms   SocialPlatform[]
  scheduledAt DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  // Lead capture from comments (§01.4/§01.6). leadCaptureKeyword configures, PER POST, the
  // keyword a commenter uses to opt in (e.g. "Atria AI"); a comment matching it + an email →
  // an opt-in lead. Null = disabled. commentSourceIds maps platform → published post id (set by
  // the lead_collector node after publish) so the poller knows which post's comments to read.
  leadCaptureKeyword String? @map("lead_capture_keyword")
  commentSourceIds   Json?   @map("comment_source_ids") // { facebook: "<postId>", instagram: "<mediaId>" }
  // Outcome.
  postUrls    Json?            @map("post_urls") // { facebook: url, ... }
  error       String?
  postedAt    DateTime?        @map("posted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  run      WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  productKnowledge ProductKnowledge? @relation(fields: [productKnowledgeId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt], name: "ix_post_status_sched")
  @@index([campaignId], name: "ix_post_campaign")
  @@index([ownerId], name: "ix_post_owner")
  @@index([runId], name: "ix_post_run")
  @@index([productKnowledgeId], name: "ix_post_pk")
  @@map("mkt_post")
}

// Reusable per-user Product Knowledge library entry (item 6). Analyze documents/images ONCE
// (Gemini multimodal → a rich factual profile) and reuse it across campaigns/posts to ground
// copy/image/video prompts — instead of re-analyzing per campaign. productDetails is the rich
// paragraph that fills the grounding slot; profile keeps the structured breakdown.
model ProductKnowledge {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  name           String   // library label (usually the product name)
  productDetails String   @map("product_details") // rich grounding paragraph
  profile        Json?    // structured ProductProfile (summary/differentiators/audience/proof)
  brandVoice     String?  @map("brand_voice")
  language       String?
  sourceDocs     String[] @map("source_docs") // uploaded file names, for provenance
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  posts      Post[]

  @@index([ownerId], name: "ix_pk_owner")
  @@map("mkt_product_knowledge")
}

// Inbound lead from any channel. Dedupe by email (30d) or calcom booking uid.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  // Leads aren't always campaign-bound, so tenancy is a direct column (plan §1).
  ownerId        String     @map("owner_id") @db.Uuid
  // name/email/phone/message hold AES-256-GCM ciphertext at rest (§01.2 PII). email_bidx is a
  // keyed HMAC of the lowercased email — the dedupe query runs on THAT (equality on ciphertext
  // is impossible). raw_payload is no longer written (no-excess-storage); kept nullable for old rows.
  name           String?
  email          String
  emailBidx      String?    @map("email_bidx")
  phone          String?
  message        String?
  sourceProduct  String?    @map("source_product")
  source         LeadSource
  calBookingUid  String?    @map("cal_booking_uid")
  rawPayload     Json?      @map("raw_payload")
  // Lead score (§01.5 hybrid): a 0-100 quality/intent score. Rule layer sets it on capture;
  // the optional LLM layer (POST /leads/:id/rescore) adjusts it. scoreReasons is the audit
  // trail — [{ layer:'rule'|'llm', reason, delta }] — so a non-tech user sees WHY.
  score          Int?
  scoreReasons   Json?      @map("score_reasons")
  receivedAt     DateTime   @default(now()) @map("received_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([emailBidx, receivedAt], name: "ix_lead_email_bidx")
  @@index([calBookingUid], name: "ix_lead_calcom_uid")
  @@index([ownerId], name: "ix_lead_owner")
  @@map("mkt_lead")
}

// OAuth token store — replaces the n8n credential vault. token + refreshToken
// are AES-256-GCM ciphertext (see lib/crypto.ts); never store plaintext.
// T4: per-user. PK is composite (ownerId, platform) — each tenant connects their
// own accounts. Pre-T4 DAIS rows are migrated onto the system owner.
model OAuthToken {
  ownerId      String         @map("owner_id") @db.Uuid
  platform     SocialPlatform
  token        String // encrypted
  refreshToken String?        @map("refresh_token") // encrypted
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)
  status       TokenStatus    @default(active)
  lastCheckedAt DateTime?     @map("last_checked_at") @db.Timestamptz(6)
  meta         Json? // platform-specific (page id, user id, etc.)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, platform])
  @@index([ownerId], name: "ix_token_owner")
  @@map("mkt_oauth_token")
}

// Master Agent chat history. Per-user, DB-backed (not local/session state) so
// sidebar Chats can restore conversations across reloads and demos. Chat content
// must not hold credential values — secrets go through AgentCredential.
model AgentChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  title     String
  draft     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages AgentChatMessage[]

  @@index([ownerId, updatedAt(sort: Desc)], name: "ix_agent_chat_owner_updated")
  @@map("agent_chat_session")
}

model AgentChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt], name: "ix_agent_chat_message_session_created")
  @@map("agent_chat_message")
}

// Generic per-agent credentials for provider keys that do not fit social OAuth.
// value is encrypted ciphertext; API responses only return status metadata.
model AgentCredential {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  agentId   String   @map("agent_id")
  key       String
  value     String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, agentId, key])
  @@index([ownerId], name: "ix_agent_credential_owner")
  @@map("agent_credential")
}

// ── Orchestration backbone (Milestone 1) ──────────────────────────────────────
// Goal-based dynamic workflow runs. A WorkflowRun is the orchestration record:
// the GoalSpec snapshot + the planned DAG + per-node run state + artifacts. It
// sits BESIDE Campaign/Post (the marketing record) — the publisher node references
// a real Post by id rather than copying its content, so there is no second source
// of truth for copy/assets. Status is a free-form string (not a Prisma enum) so new
// states scale without a migration, mirroring the config-as-data choice (T3).
model WorkflowRun {
  id            String   @id @default(uuid()) @db.Uuid
  // Denormalized tenant key (every orchestration query filters on this, like Post).
  ownerId       String   @map("owner_id") @db.Uuid
  // Optional link to the chat that spawned the run (one chat may spawn many runs).
  chatSessionId String?  @map("chat_session_id") @db.Uuid
  // User-given name once the planned flow is saved (Saved Flows). Null while still a
  // transient draft run; set via POST /runs/:id/save before execution.
  name          String?
  // GoalSpec snapshot (extracted intent) and the WorkflowPlan DAG snapshot.
  goal          Json
  plan          Json?
  // planning | awaiting_clarification | planned | running | needs_approval |
  // completed | failed | cancelled | template
  status        String   @default("planning")
  // Flow-as-template split: a saved (approved) flow is a `template` — an immutable
  // blueprint (goal + DAG, no artifacts) that is never executed. Each Post clones the
  // template into an `instance` run it executes independently. Legacy rows default to
  // `instance` so their existing behaviour (1 run = 1 post) is unchanged.
  kind          String   @default("instance") // template | instance
  // A template is frozen once approved: the master agent may not re-plan/mutate it.
  locked        Boolean  @default(false)
  // For an instance: the template it was cloned from (reuse/audit). SetNull if the
  // template is deleted so instances/posts outlive their blueprint.
  templateId    String?  @map("template_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template  WorkflowRun?      @relation("RunTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  instances WorkflowRun[]     @relation("RunTemplate")
  nodes     WorkflowNodeRun[]
  artifacts Artifact[]
  campaigns Campaign[]
  posts     Post[]

  @@index([ownerId, status], name: "ix_wf_run_owner_status")
  @@index([ownerId, kind], name: "ix_wf_run_owner_kind")
  @@index([templateId], name: "ix_wf_run_template")
  @@map("wf_run")
}

// One node's execution state within a run. dependsOn/inputRefs/outputRefs are
// plan-local node ids / artifact ids — the executor topo-sorts on dependsOn.
model WorkflowNodeRun {
  id         String    @id @default(uuid()) @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  nodeId     String    @map("node_id") // plan-local, e.g. "n2"
  agentId    String    @map("agent_id") // registry key
  // pending | running | awaiting_approval | completed | failed | skipped
  status     String    @default("pending")
  dependsOn  String[]  @map("depends_on")
  inputRefs  String[]  @map("input_refs")
  outputRefs String[]  @map("output_refs")
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  // Token/cost accounting (Phase 6). Recorded when a node completes. Estimated from
  // actual I/O for LLM nodes and a flat per-image cost for image gen; 0 for stubs. The
  // flow-template dashboard sums these across all instance runs of the template.
  promptTokens Int   @default(0) @map("prompt_tokens")
  outputTokens Int   @default(0) @map("output_tokens")
  totalTokens  Int   @default(0) @map("total_tokens")
  costUsd      Float @default(0) @map("cost_usd")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], name: "ix_wf_node_run")
  @@map("wf_node_run")
}

// A typed agent output (brief §3, §5). data is validated against the matching
// artifact Zod schema at the executor boundary before insert — not by the DB.
model Artifact {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  nodeId    String   @map("node_id") // producing node
  type      String   // research_summary | content_concept | publish_result | ...
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, type], name: "ix_wf_artifact_run_type")
  @@map("wf_artifact")
}

// Chronological audit log; detail is free-form JSON. Ported from n8n mkt_run_log.
model MktRunLog {
  id        BigInt   @id @default(autoincrement())
  // Optional tenant attribution for per-user audit (plan §1). Nullable + no FK:
  // system/cron events have no owner, and audit rows must survive user deletion.
  ownerId   String?  @map("owner_id") @db.Uuid
  level     String
  step      String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], name: "ix_mkt_log_created")
  @@index([ownerId], name: "ix_mkt_log_owner")
  @@map("mkt_run_log")
}

// Universal per-owner LLM/media usage ledger — the SINGLE source of truth for how much a
// tenant has spent on public model calls, across EVERY surface (chat, intake, copy-gen,
// research, lead rescore, product analysis, and the orchestration DAG). Real usageMetadata
// (incl. thinking tokens) is recorded here so a customer's true spend can be totalled + broken
// down by surface for billing + business analysis. Nullable owner + no FK: some calls (cron,
// system) have no tenant, and a usage row must survive user deletion. Best-effort insert —
// recording must NEVER block or fail the call it measures. wf_node_run keeps its own cost
// columns for the per-node DAG view; this ledger is the cross-surface total.
model LlmUsage {
  id           BigInt   @id @default(autoincrement())
  ownerId      String?  @map("owner_id") @db.Uuid
  // Where the spend happened: chat | intake | copygen | research | lead_rescore |
  // product_analysis | orchestration (+ agentId for DAG nodes). Free-form for future surfaces.
  surface      String
  model        String
  // Real token counts from the provider (0 for pure media calls). thoughtTokens = Gemini 2.5
  // internal reasoning (billed at the OUTPUT rate) — the biggest previously-missed cost.
  promptTokens Int      @default(0) @map("prompt_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  thoughtTokens Int     @default(0) @map("thought_tokens")
  cachedTokens Int      @default(0) @map("cached_tokens")
  totalTokens  Int      @default(0) @map("total_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  // Optional back-references for drill-down (no FK — best-effort ledger, must not cascade/block).
  runId        String?  @map("run_id") @db.Uuid
  refId        String?  @map("ref_id") // post/campaign/lead/knowledge id, surface-dependent
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerId, createdAt(sort: Desc)], name: "ix_llm_usage_owner")
  @@index([ownerId, surface], name: "ix_llm_usage_surface")
  @@map("mkt_llm_usage")
}

// Runtime-toggleable system flags (Atria Phase 03 safety) — the kill switch lives here. Keyed
// by a stable string (e.g. "external_actions_paused"); `enabled` is the toggle. A single row per
// flag; toggling is audited (who/when). Env can't be flipped at runtime, hence a DB flag.
model SystemFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mkt_system_flag")
}

// External-action audit log (brief §11.13) — one row per outward-writing action the
// Connector Runtime performs (publish to a platform, future email/CRM/upload). Records
// who/what/where/outcome with REDACTED request/response (no token, no secret — the
// runtime strips them before writing). Nullable owner + no FK so rows survive user
// deletion (audit must outlive the tenant). Append-only; never updated.
model ExternalActionAuditLog {
  id         BigInt   @id @default(autoincrement())
  ownerId    String?  @map("owner_id") @db.Uuid
  runId      String?  @map("run_id") @db.Uuid // orchestration run, when invoked from a DAG
  nodeId     String?  @map("node_id") // plan-local node id
  platform   String   // social platform / connector key
  actionKey  String   @map("action_key") // capability skill, e.g. social.post.image
  status     String   // ok | error
  externalId String?  @map("external_id") // published url/id when ok
  error      String?  // failure message (redacted)
  detail     Json?    // redacted request/response metadata (NEVER a secret)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], name: "ix_ext_audit_created")
  @@index([ownerId], name: "ix_ext_audit_owner")
  @@index([runId], name: "ix_ext_audit_run")
  @@map("external_action_audit_log")
}
