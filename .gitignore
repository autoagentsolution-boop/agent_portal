node_modules/
dist/
build/

# Env files (never commit secrets)
.env
.env.*
!.env.example
*.env
*.env.local

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build / cache
.cache/
coverage/
*.tsbuildinfo

# Render service runtime output (rendered mp4s)
render-service/output/
render-service/public/explode-cache/
render-service/out/
out/

# Storyboard v2 generated assets (regenerable via scripts/run-storyboard-v2.ts; cache-cheap)
render-service/public/storyboard-v2/*/motion-*.mp4
render-service/public/storyboard-v2/*/narration-*.mp3
render-service/public/storyboard-v2/*/music.mp3
render-service/temp/
.remotion/

# Meta/FB token dumps + screenshots with secrets (NEVER commit — live access tokens)
page.json
*page*.json
*.png

# Local reference / scratch dirs (large, user-personal)
Bokho/
ReferenceVideoType/
screenshot/

# Source/output split — only the storyboard JSON is tracked; PNG masters
# and rejected/test renders stay local (regenerable via ChatGPT, or transient)
source/*/panel-*.png
source/*/ChatGPT*.png
output/

# Claude session state (rotates frequently, not useful in repo)
.claude/session-state/
.claude/chrome-devtools/

# Claude Code session caches
.claude/cache/
.claude/.session/
.claude/hooks/.logs/
