    {
      "parameters": {
        "jsCode": "// Normalize a Google Forms response row -> lead schema.\n// Forms column headers = the full question text (VI/EN); resolve tolerantly by\n// keyword substring. Keyword ORDER matters: more specific phrases first so a\n// shared word (e.g. 'product' appears in both the product question and the\n// 'how do you know about our products' question) lands on the right column.\nconst row = $json || {};\n\nconst lk = {};\nfor (const k of Object.keys(row)) lk[k.toLowerCase().trim()] = row[k];\n\nfunction pick(keywords, fallback) {\n  for (const kw of keywords) {\n    for (const key of Object.keys(lk)) {\n      if (key.includes(kw)) {\n        const v = lk[key];\n        if (v != null && String(v).trim() !== '') return String(v).trim();\n      }\n    }\n  }\n  return fallback != null ? fallback : '';\n}\n\nconst email = pick(['email', 'e-mail', 'thư', 'mail']).toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (!emailOk) {\n  // Drop silently: malformed Forms row (or header row that slipped through).\n  return [];\n}\n\n// Timestamp: Forms writes a 'Timestamp'/'Dấu thời gian' column. Fallback to now.\nconst ts = pick(['timestamp', 'dấu thời gian', 'thời gian']);\nlet receivedAt = new Date().toISOString();\nif (ts) {\n  const d = new Date(ts);\n  if (!isNaN(d)) receivedAt = d.toISOString();\n}\n\n// 'looking for' before 'product' so the product question wins over the\n// 'how do you know about our products' question.\nconst sourceProduct = pick(['looking for', 'sản phẩm', 'dịch vụ', 'service', 'product']).slice(0, 200);\nconst challenges = pick(['challenge', 'message', 'nội dung', 'nhu cầu', 'need', 'vấn đề', 'ghi chú', 'note', 'yêu cầu']);\nconst heardFrom = pick(['how do you know', 'know about', 'hear about', 'biết', 'kênh']);\n\nconst message = [\n  challenges,\n  heardFrom ? ('Heard from: ' + heardFrom) : ''\n].filter(Boolean).join('\\n').slice(0, 2000);\n\nreturn [{ json: {\n  receivedAt,\n  name: pick(['full name', 'name', 'tên', 'họ']).slice(0, 200),\n  email,\n  phone: pick(['phone', 'mobile', 'điện thoại', 'sđt', 'sdt']).slice(0, 50),\n  message,\n  sourceProduct,\n  sourcePlatform: 'form',\n  rawPayload: JSON.stringify(row).slice(0, 5000)\n} }];"
      },
      "id": "normalize-form",
      "name": "Normalize form row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        360
      ]
    },
