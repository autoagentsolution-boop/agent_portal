    {
      "parameters": {
        "jsCode": "// Dedupe by email within 30 days. Mark isDup; always append, skip Sales email if dup.\nconst lead = $('Normalize form row').first().json;\nconst existing = $input.all().map(i => i.json);\nconst cutoff = new Date(Date.now() - 30 * 24 * 3600 * 1000);\nconst isDup = existing.some(r => {\n  if (String(r.email || '').trim().toLowerCase() !== lead.email) return false;\n  const d = new Date(r.receivedAt);\n  return !isNaN(d) && d >= cutoff;\n});\nreturn [{ json: { ...lead, isDup } }];"
      },
      "id": "dedupe",
      "name": "Dedupe by email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
