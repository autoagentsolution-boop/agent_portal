      "parameters": {
        "jsCode": "// Auth (constant-time secret, no crypto module) + validate.\nfunction safeEq(a, b) {\n  a = String(a == null ? '' : a);\n  b = String(b == null ? '' : b);\n  if (a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return diff === 0;\n}\nconst headers = $json.headers || {};\nconst body = $json.body || {};\nconst secret = headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!$env.MKT_LEAD_WEBHOOK_SECRET) throw new Error('mkt_lead: MKT_LEAD_WEBHOOK_SECRET not set');\nif (!safeEq(secret, $env.MKT_LEAD_WEBHOOK_SECRET)) {\n  return [{ json: { __status: 401, __error: 'unauthorized' } }];\n}\nconst email = String(body.email || '').trim().toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (!emailOk) {\n  return [{ json: { __status: 400, __error: 'invalid_email' } }];\n}\nreturn [{ json: {\n  __status: 200,\n  receivedAt: new Date().toISOString(),\n  name: String(body.name || '').slice(0, 200),\n  email,\n  phone: String(body.phone || '').slice(0, 50),\n  message: String(body.message || '').slice(0, 2000),\n  sourceProduct: String(body.product || body.sourceProduct || '').slice(0, 200),\n  sourcePlatform: String(body.platform || body.sourcePlatform || '').slice(0, 50),\n  rawPayload: JSON.stringify(body).slice(0, 5000)\n} }];"
      },
