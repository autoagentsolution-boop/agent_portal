    {
      "parameters": {
        "jsCode": "const item = $json;\n\nconst from = item.From || item.from || \"\";\nconst subject = item.Subject || item.subject || \"\";\nconst snippet = item.snippet || \"\";\nconst payloadText = JSON.stringify(item.payload || {});\n\nconst fullText = [\n  `Actual From: ${from}`,\n  `Actual Subject: ${subject}`,\n  `Snippet: ${snippet}`,\n  `Payload: ${payloadText}`,\n].join(\"\\n\");\n\n// Try to detect forwarded original sender/subject\nconst originalFromMatch =\n  fullText.match(/Forwarded message[\\s\\S]*?From:\\s*([^<\\n]+)<([^>\\n]+)>/i) ||\n  fullText.match(/From:\\s*([^<\\n]+)<([^>\\n]+)>/i);\n\nconst originalSubjectMatch =\n  fullText.match(/Forwarded message[\\s\\S]*?Subject:\\s*([^\\n]+)/i) ||\n  fullText.match(/Subject:\\s*([^\\n]+)/i);\n\nconst originalFromName = originalFromMatch?.[1]?.trim() || \"\";\nconst originalFromEmail = originalFromMatch?.[2]?.trim() || \"\";\nconst originalSubject = originalSubjectMatch?.[1]?.trim() || subject;\n\nconst effectiveFromEmail = originalFromEmail || from;\nconst effectiveSubject = originalSubject || subject;\n\nlet normalizedCategoryHint = \"unknown\";\n\nif (\n  /linkedin\\.com/i.test(effectiveFromEmail) ||\n  /linkedin job alert/i.test(fullText) ||\n  /job alert/i.test(effectiveSubject) ||\n  /data engineer|remote|salary|year|job/i.test(effectiveSubject)\n) {\n  normalizedCategoryHint = \"linkedin_job_alert\";\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      actualFrom: from,\n      actualSubject: subject,\n      originalFromName,\n      originalFromEmail,\n      originalSubject,\n      effectiveFromEmail,\n      effectiveSubject,\n      normalizedCategoryHint,\n      classifierText: `\nActual Gmail From: ${from}\nActual Gmail Subject: ${subject}\n\nOriginal Forwarded From: ${originalFromName} <${originalFromEmail}>\nOriginal Forwarded Subject: ${originalSubject}\n\nSnippet:\n${snippet}\n\nDetected Hint:\n${normalizedCategoryHint}\n      `.trim(),\n    },\n  },\n];"
      },
