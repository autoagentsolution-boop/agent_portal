    {
      "parameters": {
        "jsCode": "// Build asset spec + platform list from the claimed row.\nconst row = $('Pick one due row').first().json;\nconst platforms = String(row.platforms || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nif (platforms.length === 0) throw new Error('mkt_scheduler: row has no platforms');\nconst driveFolderId = String(row.driveFolderId || '').trim();\n// heroFile = exact image filename within the (possibly shared) Drive folder. Blank -> legacy hero.png fallback.\nconst heroFile = String(row.heroFile || '').trim() || 'hero.png';\nreturn [{ json: {\n  id: row.id,\n  rowNumber: row.row_number,\n  product: row.product,\n  copyVi: row.copyVi || '',\n  copyEn: row.copyEn || '',\n  platforms,\n  driveFolderId,\n  heroFile\n} }];"
      },
      "id": "build-spec",
      "name": "Build post spec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        320
      ]
    },
