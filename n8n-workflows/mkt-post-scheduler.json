    },
    {
      "parameters": {
        "jsCode": "// Resolve the post's hero image by filename (spec.heroFile) within the Drive folder.\n// Shared-folder model: one campaign/project folder holds many images; the row names which one.\n// Drive does NOT enforce unique filenames -> guard against >1 match (loud error beats wrong image).\nconst spec = $('Build post spec').first().json;\nconst files = $input.all().map(i => i.json).filter(f => f && f.id);\nconst want = String(spec.heroFile || 'hero.png').toLowerCase();\nconst matches = files.filter(f => (f.name || '').toLowerCase() === want);\nif (matches.length === 0) {\n  return [{ json: { __invalid: true, id: spec.id, rowNumber: spec.rowNumber, error: `heroFile '${spec.heroFile}' not found in Drive folder ${spec.driveFolderId}` } }];\n}\nif (matches.length > 1) {\n  return [{ json: { __invalid: true, id: spec.id, rowNumber: spec.rowNumber, error: `ambiguous heroFile '${spec.heroFile}': ${matches.length} files share this name in folder ${spec.driveFolderId}` } }];\n}\nreturn [{ json: { ...spec, heroFileId: matches[0].id } }];"
      },
      "id": "validate-assets",
      "name": "Validate assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
