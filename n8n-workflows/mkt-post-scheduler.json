    {
      "parameters": {
        "jsCode": "// Threads final: confirm publish, attach REAL permalink, append to fbResults -> single results[].\nconst carry = $('Build Threads request').first().json;\nconst results = [...(carry.fbResults || [])];\nif (!carry.skipThreads) {\n  const pub = $('Threads publish').first().json || {};\n  const perma = $json || {};\n  const mediaId = pub.id;\n  const pubErr = pub.error;\n  if (mediaId && !pubErr) {\n    // permalink GET may have failed (onError) -> fall back to media-id reference\n    const url = perma.permalink || `https://www.threads.net/@me/post/${mediaId}`;\n    results.push({ platform: 'threads', ok: true, url, error: null });\n  } else {\n    let msg = 'Threads publish failed';\n    if (pubErr) msg = typeof pubErr === 'string' ? pubErr : (pubErr.message || JSON.stringify(pubErr));\n    results.push({ platform: 'threads', ok: false, url: null, error: ('Threads: ' + msg).slice(0, 300) });\n  }\n}\nreturn [{ json: { id: carry.id, rowNumber: carry.rowNumber, results } }];"
      },
