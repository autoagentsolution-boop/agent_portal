        "jsCode": "// Threads adapter step 1: gate + build creation-container request. Carry FB results forward.\n// FB branch may have been skipped (platforms has no 'facebook') -> Normalize FB result didn't run.\nconst spec = $('Validate assets').first().json;\nlet fbResults = [];\nlet id = spec.id, rowNumber = spec.rowNumber;\ntry {\n  const fb = $('Normalize FB result').first().json;\n  if (fb && Array.isArray(fb.results)) { fbResults = fb.results; id = fb.id; rowNumber = fb.rowNumber; }\n} catch (e) { /* FB branch skipped; keep empty fbResults */ }\nconst platforms = spec.platforms || [];\nconst carry = { id, rowNumber, fbResults };\nif (!platforms.includes('threads')) { return [{ json: { ...carry, skipThreads: true } }]; }\nconst imageUrl = `https://lh3.googleusercontent.com/d/${spec.heroFileId}`;\nlet text = String(spec.copyVi || '');\nif (text.length > 500) { text = text.slice(0, 497); text = text.slice(0, text.lastIndexOf(' ')) + '\\u2026'; }\nreturn [{ json: { ...carry, skipThreads: false, imageUrl, text } }];"
      },
