    {
      "parameters": {
        "jsCode": "// Normalize FB /photos response (or error) into contract {results:[{platform,ok,url,error}]}.\n// Both success + continueErrorOutput branches land here; $json carries whichever fired.\nconst meta = $('Validate assets').first().json;\nconst platforms = meta.platforms || [];\nconst resp = $json || {};\nconst results = [];\nif (platforms.includes('facebook')) {\n  const errObj = resp.error;\n  const pid = resp.post_id || resp.id;\n  if (pid && !errObj) {\n    results.push({ platform:'facebook', ok:true, url:`https://facebook.com/${pid}`, error:null });\n  } else {\n    let msg = 'FB publish failed';\n    if (errObj) msg = typeof errObj==='string' ? errObj : (errObj.message || JSON.stringify(errObj));\n    else if (resp.message) msg = resp.message;\n    results.push({ platform:'facebook', ok:false, url:null, error:('FB: '+msg).slice(0,300) });\n  }\n}\n// (Threads + other platforms handled by their own dedicated branches downstream.)\nreturn [{ json: { id: meta.id, rowNumber: meta.rowNumber, results } }];"
      },
      "id": "fanout-adapters",
      "name": "Normalize FB result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2760,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate per-platform results → terminal status + write-back payload.\nconst row = $json;\nconst results = row.results || [];\nconst okCount = results.filter(r => r.ok).length;\nlet status;\nif (okCount === results.length && okCount > 0) status = 'posted';\nelse if (okCount > 0) status = 'partial';\nelse status = 'error';\nconst postUrl = {};\nfor (const r of results) if (r.ok && r.url) postUrl[r.platform] = r.url;\nconst errParts = results.filter(r => !r.ok).map(r => `${r.platform}:${r.error}`);\nreturn [{ json: {\n  id: row.id,\n  row_number: row.rowNumber,\n  status,\n  postUrl: JSON.stringify(postUrl),\n  postedAt: new Date().toISOString(),\n  error: errParts.join(' | ').slice(0, 500)\n} }];"
      },
      "id": "aggregate",
      "name": "Aggregate results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2540,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validation-error path: build write-back marking row=error, no network post happened.\nconst v = $json;\nreturn [{ json: {\n  id: v.id,\n  row_number: v.rowNumber,\n  status: 'error',\n  postUrl: '{}',\n  postedAt: new Date().toISOString(),\n  error: (v.error || 'validation failed').slice(0, 500)\n} }];"
      },
