    {
      "parameters": {
        "jsCode": "// Dedupe by Cal.com booking UID (each booking = one lead, survives webhook retry).\n// Falls back to email+30d if UID missing.\nconst lead = $('Auth + parse booking').first().json;\nconst existing = $input.all().map(i => i.json);\nlet isDup = false;\nif (lead.calBookingUid) {\n  isDup = existing.some(r => String(r.rawPayload || '').includes('\"calBookingUid\":\"' + lead.calBookingUid + '\"'));\n}\nif (!isDup) {\n  const cutoff = new Date(Date.now() - 30 * 24 * 3600 * 1000);\n  isDup = existing.some(r => {\n    if (String(r.email || '').trim().toLowerCase() !== lead.email) return false;\n    if (String(r.sourcePlatform || '') !== 'calcom') return false;\n    const d = new Date(r.receivedAt);\n    return !isNaN(d) && d >= cutoff;\n  });\n}\nreturn [{ json: { ...lead, isDup } }];"
      },
