    {
      "parameters": {
        "jsCode": "// Cal.com BOOKING_CREATED -> lead schema.\n// Cal.com signs the body with HMAC-SHA256 in 'x-cal-signature-256'. The n8n\n// task-runner sandbox blocks require('crypto'), so we cannot recompute the\n// HMAC here. Instead we gate on a shared secret in the URL query (?s=...),\n// constant-time compared. Cal.com lets you append query params to the webhook\n// URL, so this is the sandbox-safe equivalent of the lead-capture secret.\nfunction safeEq(a, b) {\n  a = String(a == null ? '' : a);\n  b = String(b == null ? '' : b);\n  if (a.length !== b.length) return false;\n  let diff = 0;\n  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return diff === 0;\n}\nconst query = $json.query || {};\nconst body = $json.body || {};\nif (!$env.MKT_CALCOM_WEBHOOK_SECRET) throw new Error('mkt_calcom: MKT_CALCOM_WEBHOOK_SECRET not set');\nif (!safeEq(query.s, $env.MKT_CALCOM_WEBHOOK_SECRET)) {\n  return [{ json: { __status: 401, __error: 'unauthorized' } }];\n}\n\n// Only act on booking creation; ignore other event types if they ever arrive.\nconst triggerEvent = body.triggerEvent || '';\nif (triggerEvent && triggerEvent !== 'BOOKING_CREATED') {\n  return [{ json: { __status: 202, __error: 'ignored_event', __event: triggerEvent } }];\n}\n\nconst p = body.payload || {};\nconst attendee = (Array.isArray(p.attendees) && p.attendees[0]) || {};\nconst email = String(attendee.email || '').trim().toLowerCase();\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (!emailOk) {\n  return [{ json: { __status: 400, __error: 'invalid_email' } }];\n}\n\n// Meeting link: Cal.com exposes it in several shapes across versions.\nconst meetUrl = String(\n  p.videoCallData?.url ||\n  p.metadata?.videoCallUrl ||\n  p.location ||\n  ''\n).slice(0, 500);\nconst meetingAt = String(p.startTime || '').slice(0, 50);\nconst calBookingUid = String(p.uid || p.bookingId || '').slice(0, 100);\nconst title = String(p.title || p.eventTitle || 'Cal.com booking').slice(0, 200);\nconst attendeeMessage = String(p.additionalNotes || attendee.notes || '').slice(0, 1000);\n\n// Pack meeting metadata into message + rawPayload (leads tab stays 8 cols).\nconst message = [\n  title,\n  meetingAt ? ('Meeting: ' + meetingAt) : '',\n  meetUrl ? ('Link: ' + meetUrl) : '',\n  attendeeMessage\n].filter(Boolean).join('\\n').slice(0, 2000);\n\nreturn [{ json: {\n  __status: 200,\n  receivedAt: new Date().toISOString(),\n  name: String(attendee.name || '').slice(0, 200),\n  email,\n  phone: String(attendee.phoneNumber || '').slice(0, 50),\n  message,\n  sourceProduct: title,\n  sourcePlatform: 'calcom',\n  calBookingUid,\n  rawPayload: JSON.stringify({ meetingAt, meetUrl, calBookingUid, payload: p }).slice(0, 5000)\n} }];"
      },
