# =============================================================================
# Video Content Farm — Environment Variables
# Copy to `.env` and fill values. Never commit `.env`.
# =============================================================================

# --- Postgres (Docker) -------------------------------------------------------
POSTGRES_DB=videofarm
POSTGRES_USER=videofarm
POSTGRES_PASSWORD=change-me

# --- n8n basic auth (Docker UI) ---------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- LLM (script generation) ------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Image generation (Nano Banana = Gemini Image API) ----------------------
# Same key as GEMINI_API_KEY unless using a separate billing project
NANO_BANANA_API_KEY=

# --- Video gen backend selection (storyboard v2 i2v motion) -----------------
# 'veo'   = Google Veo 3.1 via GEMINI_API_KEY (above). Bills per SECOND of output ($0.05/sec Lite 720p,
#           $0.10/sec Fast 720p — fallback on Lite quota 429). Free-tier KHÔNG có; Tier 1 ~20/day cap.
#           Needs Cloud billing enabled on the AI Studio project for usable quota.
# 'kling' = Kling 2.1 via Replicate (REQUIRES REPLICATE_API_TOKEN below). Bills per generation (unit):
#           Standard 5s = $0.25, 10s = $0.50; Pro 5s = $0.45, 10s = $0.90. Pay-per-use, no daily cap.
VIDEO_PROVIDER=veo

# Veo per-second rate override (default $0.05 = Lite 720p). Set to 0.08 (Lite 1080p), 0.10 (Fast 720p),
# 0.12 (Fast 1080p), or 0.40 (Standard) if your usage pattern triggers a different tier.
# VEO_USD_PER_SEC=0.05

# Replicate token — only required when VIDEO_PROVIDER=kling. Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional Kling model + mode overrides (defaults below)
KLING_MODEL=kwaivgi/kling-v2.1
# KLING_MODE: 'standard' (cheaper, faster) or 'pro' (better motion + end_image support)
KLING_MODE=standard
# KLING_PLATFORM: 'replicate' (default — uses gen-kling-motion.ts via Replicate API, ~12% cheaper)
# or 'klingai' (klingai.com direct via Kuaishou Resource Pack — requires separate client, NOT IMPLEMENTED YET).
# This flag ONLY affects cost accounting. To actually use klingai.com you must write a klingai client.
KLING_PLATFORM=replicate

# --- Stock media -------------------------------------------------------------
PEXELS_API_KEY=
# Pixabay reserved as Phase-10 fallback (not used in Phase 08)
PIXABAY_API_KEY=

# --- TTS ---------------------------------------------------------------------
# Edge TTS: free, no key required
# Google Cloud TTS (Phase 09): EITHER point GOOGLE_APPLICATION_CREDENTIALS to a
# mounted JSON file, OR set GOOGLE_TTS_CREDENTIALS_BASE64 to base64-encoded SA key.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_CREDENTIALS_BASE64=

# --- YouTube Data API v3 -----------------------------------------------------
# OAuth client created in Google Cloud Console; full setup: docs/oauth-setup.md
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=

# --- Facebook Graph API (Reels) ----------------------------------------------
# Long-lived Page Access Token (60-day expiry); setup: docs/oauth-setup.md §2
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Required only by fb-token-refresh workflow (Phase 11):
FB_APP_ID=
FB_APP_SECRET=
FB_CREDENTIAL_ID=
# n8n internal API key for credential updates (FB token refresh workflow)
N8N_API_KEY=

# --- Cost guardrail (Phase 10) -----------------------------------------------
MAX_DAILY_COST_USD=2

# --- Render service ----------------------------------------------------------
RENDER_SERVICE_URL=http://render-service:7000
# Shared secret n8n sends in X-Internal-Secret header
RENDER_SECRET=change-me

# --- Cooking explode pipeline (Phase 12) -------------------------------------
# Music: pre-built royalty-free library (no API needed).
# Drop 5-10 lo-fi instrumental .mp3 files into render-service/public/music-library/lofi-vn/
# Sources: YouTube Audio Library, Pixabay Music, Free Music Archive (CC0).
# Override default lookup dir:
MUSIC_LIBRARY_DIR=
# Override default cache dir for cooking-explode assets
# (default: render-service/public/explode-cache)
EXPLODE_CACHE_DIR=

# =============================================================================
# Marketing + Lead-Gen Pipeline (separate from video farm)
# Workflows: mkt-post-scheduler, mkt-lead-capture, mkt-meta-token-refresh
# =============================================================================

# --- Google control plane ----------------------------------------------------
# Spreadsheet holding `calendar` + `leads` tabs (the control plane).
MKT_SHEET_ID=
# n8n credentials (created in n8n UI, referenced by name in the workflow JSON):
#   "Marketing Google Sheets"  (googleSheetsOAuth2Api)
#   "Marketing Google Drive"   (googleDriveOAuth2Api)
#   "Marketing Gmail (Sales)"  (gmailOAuth2)
# No keys here — OAuth tokens live in the n8n credential vault.

# --- Lead capture (mkt-lead-capture) -----------------------------------------
# Shared secret the Google Form Apps Script sends in the X-Webhook-Secret header.
MKT_LEAD_WEBHOOK_SECRET=change-me
# Mailbox that receives the Sales lead notification.
MKT_SALES_EMAIL=

# --- Meta posting (FB Page + Threads) — mkt-post-scheduler / token-refresh ---
# Namespaced MKT_* to avoid collision with the video-farm FB_* vars.
MKT_FB_APP_ID=
MKT_FB_APP_SECRET=
MKT_FB_PAGE_ID=
MKT_FB_PAGE_ACCESS_TOKEN=
# n8n credential ID for the FB Page token (PATCH target of weekly refresh).
MKT_FB_CREDENTIAL_ID=
# Threads (optional in Phase 1 — leave blank until the Threads account exists;
# the refresh workflow skips Threads when these are unset).
MKT_THREADS_USER_ID=
MKT_THREADS_ACCESS_TOKEN=
MKT_THREADS_CREDENTIAL_ID=
# N8N_API_KEY (already defined above) is reused by the token-refresh PATCH call.
